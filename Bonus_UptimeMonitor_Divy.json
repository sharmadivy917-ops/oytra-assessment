{
  "name": "Uptime Monitor — demo.realworld.io → Discord",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 5 }]
        }
      },
      "id": "node-ping-schedule",
      "name": "Schedule — Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 340]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://demo.realworld.io",
        "options": {
          "timeout": 8000,
          "response": {
            "response": { "fullResponse": true, "responseFormat": "text" }
          },
          "redirect": { "redirect": { "followRedirects": true, "maxRedirects": 3 } }
        }
      },
      "id": "node-ping",
      "name": "HTTP Ping — demo.realworld.io",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 340],
      "onError": "continueErrorOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Retry logic: if first ping failed (error output), try once more\nconst item = $input.first();\nconst hasError = item?.json?.error || item?.json?.statusCode >= 400;\n\nif (hasError) {\n  // Signal downstream: retry needed\n  return [{ json: { retry: true, firstError: item.json } }];\n}\n\n// Parse response — n8n full response returns statusCode at top level\nconst status = item.json?.statusCode || item.json?.response?.statusCode || 200;\nconst responseTime = item.json?.headers?.['x-response-time'] || 'N/A';\n\nreturn [{ json: {\n  retry: false,\n  status,\n  responseTime,\n  ok: status === 200,\n  url: 'https://demo.realworld.io',\n  checkedAt: new Date().toISOString()\n}}];"
      },
      "id": "node-check-status",
      "name": "Parse Status & Flag Retry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 340]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://demo.realworld.io",
        "options": {
          "timeout": 10000,
          "response": {
            "response": { "fullResponse": true, "responseFormat": "text" }
          }
        }
      },
      "id": "node-retry-ping",
      "name": "Retry Ping (Once)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 200],
      "onError": "continueErrorOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.retry }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-retry-if",
      "name": "IF — Needs Retry?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 380]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-ok-check",
      "name": "IF — Site is UP (200)?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1200, 380]
    },
    {
      "parameters": {
        "jsCode": "// Build DOWN alert\nconst d = $input.first().json;\nconst now = new Date().toUTCString();\nconst status = d.status || d.statusCode || 'TIMEOUT/ERROR';\nreturn [{ json: {\n  content: `🔴 **SITE DOWN ALERT**\\n**URL:** https://demo.realworld.io\\n**Status:** ${status}\\n**Time:** ${now}\\n\\n_Automatic alert from Uptime Monitor workflow._`\n}}];"
      },
      "id": "node-build-down",
      "name": "Build DOWN Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $credentials.discordWebhookUrl }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "content", "value": "={{ $json.content }}" }
          ]
        },
        "options": {}
      },
      "id": "node-discord-alert",
      "name": "Discord — Send DOWN Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "credentials": { "httpHeaderAuth": { "id": "cred-discord", "name": "Discord Webhook URL" } },
      "position": [1680, 260]
    },
    {
      "parameters": {
        "jsCode": "// Site is UP — log silently (no Discord noise for healthy checks)\n// But store response time for daily summary\nconst d = $input.first().json;\nconsole.log(`[Uptime] UP | status=${d.status} | checkedAt=${d.checkedAt}`);\nreturn [{ json: { logged: true, ...d } }];"
      },
      "id": "node-log-up",
      "name": "Log UP (Silent)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 480]
    }
  ],
  "connections": {
    "Schedule — Every 5 Minutes": {
      "main": [[{ "node": "HTTP Ping — demo.realworld.io", "type": "main", "index": 0 }]]
    },
    "HTTP Ping — demo.realworld.io": {
      "main": [
        [{ "node": "Parse Status & Flag Retry", "type": "main", "index": 0 }],
        [{ "node": "Parse Status & Flag Retry", "type": "main", "index": 0 }]
      ]
    },
    "Parse Status & Flag Retry": {
      "main": [[{ "node": "IF — Needs Retry?", "type": "main", "index": 0 }]]
    },
    "IF — Needs Retry?": {
      "main": [
        [{ "node": "Retry Ping (Once)", "type": "main", "index": 0 }],
        [{ "node": "IF — Site is UP (200)?", "type": "main", "index": 0 }]
      ]
    },
    "Retry Ping (Once)": {
      "main": [
        [{ "node": "IF — Site is UP (200)?", "type": "main", "index": 0 }],
        [{ "node": "Build DOWN Alert", "type": "main", "index": 0 }]
      ]
    },
    "IF — Site is UP (200)?": {
      "main": [
        [{ "node": "Log UP (Silent)", "type": "main", "index": 0 }],
        [{ "node": "Build DOWN Alert", "type": "main", "index": 0 }]
      ]
    },
    "Build DOWN Alert": {
      "main": [[{ "node": "Discord — Send DOWN Alert", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveExecutionProgress": true
  },
  "meta": {
    "instanceId": "assessment-submission"
  }
}
